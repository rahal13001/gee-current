{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/glorys-current/gee-source-asset.schema.json",
  "title": "GLORYS12V1 GEE source asset manifest",
  "description": "Offline contract for a selected source asset. It does not upload or inspect Earth Engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_role",
    "name",
    "tilesets",
    "bands",
    "properties",
    "startTime",
    "endTime"
  ],
  "properties": {
    "schema_version": {
      "const": "gee-source-asset-1.0"
    },
    "asset_role": {
      "const": "source"
    },
    "name": {
      "type": "string",
      "pattern": "^projects/[^/]+/assets/[^/]+/.+"
    },
    "tilesets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "$ref": "#/$defs/tileset"
        }
      ],
      "items": false
    },
    "bands": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/uo_band"
        },
        {
          "$ref": "#/$defs/vo_band"
        }
      ],
      "items": false
    },
    "properties": {
      "$ref": "#/$defs/source_properties"
    },
    "startTime": {
      "$ref": "#/$defs/utc_datetime"
    },
    "endTime": {
      "$ref": "#/$defs/utc_datetime"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "properties": {
              "properties": {
                "dataset_id": {
                  "const": "cmems_mod_glo_phy_my_0.083deg_P1D-m"
                },
                "temporal_resolution": {
                  "const": "daily_mean"
                },
                "period_type": {
                  "const": "daily_jfm"
                }
              }
            }
          }
        },
        {
          "properties": {
            "properties": {
              "properties": {
                "dataset_id": {
                  "const": "cmems_mod_glo_phy_my_0.083deg_P1M-m"
                },
                "temporal_resolution": {
                  "const": "monthly_mean"
                },
                "period_type": {
                  "const": "monthly_all"
                }
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "utc_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "tileset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sources"],
      "properties": {
        "id": {
          "const": "source"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uris"],
            "properties": {
              "uris": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^gs://.+"
                }
              }
            }
          }
        }
      }
    },
    "band_common": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tilesetBandIndex", "pyramidingPolicy", "missingData"],
      "properties": {
        "id": {
          "type": "string"
        },
        "tilesetBandIndex": {
          "type": "integer",
          "minimum": 0
        },
        "pyramidingPolicy": {
          "const": "MEAN"
        },
        "missingData": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": {
            "values": {
              "const": [-9999]
            }
          }
        }
      }
    },
    "uo_band": {
      "allOf": [
        {
          "$ref": "#/$defs/band_common"
        },
        {
          "properties": {
            "id": {
              "const": "uo"
            },
            "tilesetBandIndex": {
              "const": 0
            }
          }
        }
      ]
    },
    "vo_band": {
      "allOf": [
        {
          "$ref": "#/$defs/band_common"
        },
        {
          "properties": {
            "id": {
              "const": "vo"
            },
            "tilesetBandIndex": {
              "const": 1
            }
          }
        }
      ]
    },
    "source_properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "dataset_id",
        "dataset_version",
        "dataset_part",
        "source_model",
        "processing_type",
        "temporal_resolution",
        "period_type",
        "period_start",
        "period_end",
        "period_end_inclusive",
        "depth_m",
        "depth_label",
        "uo_units",
        "vo_units",
        "direction_convention",
        "source_crs",
        "source_grid",
        "conversion_version",
        "pipeline_version",
        "config_hash",
        "source_filename",
        "source_checksum",
        "nodata_value",
        "mask_policy",
        "is_reanalysis",
        "tides_included",
        "data_status",
        "aoi_id",
        "usage_limitations",
        "created_utc"
      ],
      "properties": {
        "product_id": {
          "const": "GLOBAL_MULTIYEAR_PHY_001_030"
        },
        "dataset_id": {
          "type": "string",
          "enum": [
            "cmems_mod_glo_phy_my_0.083deg_P1D-m",
            "cmems_mod_glo_phy_my_0.083deg_P1M-m"
          ]
        },
        "dataset_version": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        },
        "dataset_part": {
          "type": "string",
          "minLength": 1
        },
        "source_model": {
          "const": "GLORYS12V1"
        },
        "processing_type": {
          "const": "reanalysis"
        },
        "temporal_resolution": {
          "enum": ["daily_mean", "monthly_mean"]
        },
        "period_type": {
          "enum": ["daily_jfm", "monthly_all"]
        },
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "period_end_inclusive": {
          "const": false
        },
        "depth_m": {
          "const": 0.494025
        },
        "depth_label": {
          "const": "top_model_layer"
        },
        "uo_units": {
          "const": "m s-1"
        },
        "vo_units": {
          "const": "m s-1"
        },
        "direction_convention": {
          "const": "towards_clockwise_from_north"
        },
        "source_crs": {
          "type": "string",
          "minLength": 1
        },
        "source_grid": {
          "$ref": "#/$defs/grid"
        },
        "conversion_version": {
          "type": "string",
          "minLength": 1
        },
        "pipeline_version": {
          "type": "string",
          "minLength": 1
        },
        "config_hash": {
          "$ref": "#/$defs/sha256"
        },
        "source_filename": {
          "type": "string",
          "minLength": 1
        },
        "source_checksum": {
          "$ref": "#/$defs/sha256"
        },
        "nodata_value": {
          "const": -9999
        },
        "mask_policy": {
          "const": "joint_uo_vo_valid"
        },
        "is_reanalysis": {
          "const": true
        },
        "tides_included": {
          "const": false
        },
        "data_status": {
          "enum": ["validated", "validated_with_notes", "pending_validation"]
        },
        "aoi_id": {
          "type": "string",
          "minLength": 1
        },
        "usage_limitations": {
          "type": "string",
          "minLength": 1
        },
        "created_utc": {
          "$ref": "#/$defs/utc_datetime"
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crs", "transform", "shape"],
      "properties": {
        "crs": {
          "type": "string",
          "minLength": 1
        },
        "transform": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "items": false
        },
        "shape": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "items": false
        }
      }
    }
  }
}
